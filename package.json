{
  "name": "gospellabs",
  "version": "2.2.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve-out.mjs",
    "deploy": "bash scripts/deploy.sh",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "questions:schema": "UPDATE_QUESTION_SCHEMA=1 vitest run src/data/question-bank.test.ts",
    "verify:references": "node scripts/verify-references.mjs && node scripts/verify-study-content.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "test:e2e": "playwright test",
    "verify:study": "node scripts/verify-study-content.mjs",
    "learner-questions": "node scripts/import-learner-questions.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "22.x"
  }
}
